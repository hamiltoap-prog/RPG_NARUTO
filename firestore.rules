rules_version = '2';

// Modelo de acesso da Mesa Ninja:
// - Qualquer pessoa autenticada (mesmo anonimamente) que conheça o código da
//   mesa pode LER a mesa inteira — fichas, log e fila de pedidos do próprio
//   personagem — para acompanhar o jogo em tempo real.
// - O Mestre (gmUid) pode escrever em qualquer campo de qualquer ficha,
//   sempre, sem passar por aprovação.
// - Um jogador só pode escrever direto na PRÓPRIA ficha nos campos "notes"
//   e nos campos que o Mestre marcou em autoApproveFields. Qualquer outro
//   campo só muda através de um documento em /requests, que só o Mestre
//   pode aprovar (isso concede permissão pra ele escrever na ficha).
// - Ninguém cria personagem em nome de outra pessoa, nem "rouba" a mesa
//   trocando o gmUid por conta própria.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isGM(tableId) {
      return signedIn() &&
        (get(/databases/$(database)/documents/tables/$(tableId)).data.gmUid == request.auth.uid ||
          isSuperAdmin());
    }

    function tableData(tableId) {
      return get(/databases/$(database)/documents/tables/$(tableId)).data;
    }

    function autoApproveKeys(tableId) {
      return tableData(tableId).autoApproveFields;
    }

    // O super administrador é identificado por um documento em /superAdmins,
    // criado fora do app (pelo Admin SDK) — nunca pelo cliente.
    function isSuperAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid));
    }

    match /superAdmins/{uid} {
      // Cada um só consegue checar o próprio crachá; ninguém cria pelo app.
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Índice particular de cada mestre: as mesas que ele criou, para
    // reencontrá-las ao entrar de outro dispositivo. Só o dono lê e escreve.
    match /gmTables/{uid}/tables/{tableId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /tables/{tableId} {
      allow get: if signedIn();
      // Listar todas as mesas revelaria os códigos alheios: só o super admin.
      allow list: if isSuperAdmin();
      allow create: if signedIn() &&
        request.resource.data.gmUid == request.auth.uid &&
        request.resource.data.id == tableId &&
        request.resource.data.code == tableId;
      allow update: if isGM(tableId) && request.resource.data.gmUid == resource.data.gmUid;
      // Apagar a mesa inteira é privilégio do super administrador.
      allow delete: if isSuperAdmin();

      match /characters/{characterId} {
        allow read: if signedIn();
        allow create: if signedIn() &&
          request.resource.data.ownerUid == request.auth.uid &&
          request.resource.data.tableId == tableId;
        allow update: if isGM(tableId) ||
          (signedIn() &&
            resource.data.ownerUid == request.auth.uid &&
            request.resource.data.ownerUid == resource.data.ownerUid &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['notes', 'updatedAt'].concat(autoApproveKeys(tableId)))) ||
          // "Reivindicar" um personagem existente pelo nome (ex: jogador
          // entrando de outro dispositivo/navegador): só permite trocar o
          // ownerUid pro uid de quem chama, mais nada — nenhum outro campo
          // pode mudar na mesma escrita.
          //
          // Ficha de NPC nunca é reivindicável: ela vive na mesma coleção, e
          // sem esta linha bastaria digitar o nome do vilão para assumi-lo.
          (signedIn() &&
            resource.data.get('isNPC', false) == false &&
            request.resource.data.ownerUid == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid', 'updatedAt']));
        allow delete: if isGM(tableId) || resource.data.ownerUid == request.auth.uid;
      }

      match /requests/{requestId} {
        allow read: if isGM(tableId) || (signedIn() && resource.data.ownerUid == request.auth.uid);
        allow create: if signedIn() &&
          request.resource.data.ownerUid == request.auth.uid &&
          request.resource.data.tableId == tableId &&
          request.resource.data.status == 'pending';
        // Só o Mestre transiciona o status (aprovar/rejeitar); a aplicação
        // do patch na ficha em si é coberta pela regra de /characters acima.
        allow update: if isGM(tableId);
        allow delete: if isGM(tableId);
      }

      match /log/{logId} {
        allow read: if signedIn();
        allow create: if signedIn();
        allow update, delete: if isGM(tableId);
      }

      // Rolagens secretas do mestre. Fechada de ponta a ponta: é isto, e não
      // um campo "secreto" no registro da mesa, que impede um jogador curioso
      // de ler o resultado pelo console do navegador.
      match /gmRolls/{rollId} {
        allow read, write: if isGM(tableId);
      }

      // Fila de rolagens: o jogador pede, só o mestre libera. O resultado é
      // sorteado no cliente do mestre na hora da liberação — por isso o
      // jogador não pode escrever no documento depois de criá-lo.
      match /rollRequests/{requestId} {
        allow read: if signedIn();
        allow create: if signedIn() &&
          request.resource.data.requesterUid == request.auth.uid &&
          request.resource.data.tableId == tableId &&
          request.resource.data.status == 'pending';
        allow update, delete: if isGM(tableId);
      }

      // Tela de jogo: o mestre monta a cena; os jogadores só escrevem quando a
      // mesa libera o arraste das próprias peças — e mesmo aí, apenas o campo
      // "tokens" pode mudar (nada de mexer em névoa, mapa ou iluminação).
      match /scene/{sceneId} {
        allow read: if signedIn();
        allow write: if isGM(tableId);
        allow update: if signedIn() &&
          tableData(tableId).playersMoveTokens == true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tokens', 'updatedAt']);
      }

      // Marcações rápidas no mapa ("olhem aqui"): qualquer um da mesa cria,
      // todos veem, e somem sozinhas na tela. A faxina é feita pelo mestre.
      match /pings/{pingId} {
        allow read, create: if signedIn();
        allow update, delete: if isGM(tableId);
      }

      // Clãs da casa: o jogador precisa lê-los para escolher na criação, mas
      // só o mestre cadastra.
      match /clans/{clanId} {
        allow read: if signedIn();
        allow write: if isGM(tableId);
      }

      // Doação de chakra: o médico pede, só o mestre libera. A transferência
      // em si é feita pelo cliente do mestre, que tem permissão nas duas
      // fichas — por isso o pedido é só um bilhete, e não uma escrita.
      match /chakraGifts/{giftId} {
        allow read: if signedIn();
        allow create: if signedIn() &&
          request.resource.data.requesterUid == request.auth.uid &&
          request.resource.data.tableId == tableId &&
          request.resource.data.status == 'pending';
        allow update, delete: if isGM(tableId);
      }

      // Lançamento de jutsu: o conjurador manda a intenção, o mestre libera.
      // Aplicar dano mexe na ficha do alvo, então quem escreve o resultado é
      // o cliente do mestre — o pedido em si é só um bilhete.
      match /jutsuCasts/{castId} {
        allow read: if signedIn();
        allow create: if signedIn() &&
          request.resource.data.requesterUid == request.auth.uid &&
          request.resource.data.tableId == tableId &&
          request.resource.data.status == 'pending';
        allow update, delete: if isGM(tableId);
      }

      // Mesa de som: o player de cada um precisa saber o que tocar, então
      // todos leem; a trilha em si é do mestre.
      match /sound/{trackId} {
        allow read: if signedIn();
        allow write: if isGM(tableId);
      }

      // Loja: todos veem a vitrine, só o mestre define preço e estoque.
      match /shop/{itemId} {
        allow read: if signedIn();
        allow write: if isGM(tableId);
      }

      // Bestiário da mesa: criaturas que o mestre preparou. Bastidor — o grupo
      // só conhece a criatura quando ela vira NPC na mesa.
      match /bestiary/{creatureId} {
        allow read, write: if isGM(tableId);
      }

      // Biblioteca de mapas e peças prontas: coisa de bastidor do mestre.
      match /sceneLibrary/{itemId} {
        allow read, write: if isGM(tableId);
      }

      match /npcs/{npcId} {
        allow read: if signedIn();
        allow write: if isGM(tableId);
      }

      match /missions/{missionId} {
        allow read: if signedIn();
        allow write: if isGM(tableId);
      }
    }
  }
}
